<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#141b2d">
<title>Horario docente UFV + ESIC 2026–27</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Instrument+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap">
<style>
/* Layout: cabecera con control de cuatrimestre → barra de vistas → calendario semanal + columna lateral de fechas clave */
:root{
  --bg:#f2f4f8;--surface:#ffffff;--surface-2:#f7f8fb;--ink:#141b2d;--muted:#5d6779;--line:#dce1ea;--line-soft:#eef1f5;
  --accent:#1c2741;--accent-ink:#ffffff;--focus:#2457d6;
  --ufv:#2457d6;--ufv-soft:#e7eefc;--esic:#c06505;--esic-soft:#fdf0e1;--meet:#0d8463;--meet-soft:#e1f4ec;--personal:#7a8496;--personal-soft:#eef0f4;
  --hol:#c2264b;--hol-soft:#fdebef;--now:#e0313f;
  --k-tfg:#6d3fd6;--k-tfm:#bf3384;--k-delegados:#0a8aa1;--k-practicas:#4a8510;--k-examen:#d1372a;--k-actas:#56637b;--k-tutoria:#3b4fc8;--k-otro:#7a6243;
  --shadow:0 1px 2px rgba(20,27,45,.05),0 10px 30px rgba(20,27,45,.07);
  --f-display:"Bricolage Grotesque","Segoe UI",system-ui,sans-serif;
  --f-body:"Instrument Sans",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --f-mono:"JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,monospace;
  color-scheme:light;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0e131d;--surface:#161d2a;--surface-2:#1b2331;--ink:#e8ecf4;--muted:#9aa4b7;--line:#2a3446;--line-soft:#212a3a;
  --accent:#e8ecf4;--accent-ink:#0e131d;--focus:#7aa0ff;
  --ufv:#7aa0ff;--ufv-soft:#1a2747;--esic:#f2a54d;--esic-soft:#35250f;--meet:#45cda3;--meet-soft:#11312a;--personal:#8d97a9;--personal-soft:#222a39;
  --hol:#f37a95;--hol-soft:#3a1824;--now:#ff5b66;
  --k-tfg:#a98bff;--k-tfm:#f07cc0;--k-delegados:#4fd0e6;--k-practicas:#9ad15a;--k-examen:#ff7a6b;--k-actas:#a3afc4;--k-tutoria:#8d9cff;--k-otro:#d1b48d;
  --shadow:0 1px 2px rgba(0,0,0,.3),0 10px 30px rgba(0,0,0,.35);color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0e131d;--surface:#161d2a;--surface-2:#1b2331;--ink:#e8ecf4;--muted:#9aa4b7;--line:#2a3446;--line-soft:#212a3a;
  --accent:#e8ecf4;--accent-ink:#0e131d;--focus:#7aa0ff;
  --ufv:#7aa0ff;--ufv-soft:#1a2747;--esic:#f2a54d;--esic-soft:#35250f;--meet:#45cda3;--meet-soft:#11312a;--personal:#8d97a9;--personal-soft:#222a39;
  --hol:#f37a95;--hol-soft:#3a1824;--now:#ff5b66;
  --k-tfg:#a98bff;--k-tfm:#f07cc0;--k-delegados:#4fd0e6;--k-practicas:#9ad15a;--k-examen:#ff7a6b;--k-actas:#a3afc4;--k-tutoria:#8d9cff;--k-otro:#d1b48d;
  --shadow:0 1px 2px rgba(0,0,0,.3),0 10px 30px rgba(0,0,0,.35);color-scheme:dark}

*{box-sizing:border-box}
[hidden]{display:none!important}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.45 var(--f-body);padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:0 40px}
.wrap{max-width:1480px;margin:0 auto}
button,select,input,textarea{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:2px solid var(--focus);outline-offset:2px}
.mono{font-family:var(--f-mono);font-variant-numeric:tabular-nums}

/* Cabecera */
header.top{display:flex;flex-wrap:wrap;gap:16px 28px;align-items:flex-end;justify-content:space-between;padding-block:28px 18px}
.eyebrow{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:600;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.eyebrow .dot{width:8px;height:8px;border-radius:50%;display:inline-block}
h1{font-family:var(--f-display);font-weight:800;font-size:clamp(28px,4.2vw,46px);letter-spacing:-.03em;line-height:1.02;margin:6px 0 0;text-wrap:balance}
h1 em{font-style:normal;color:var(--muted);font-weight:600}
.seg{display:inline-flex;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:4px;gap:2px;box-shadow:var(--shadow)}
.seg button{border:0;background:transparent;border-radius:10px;padding:9px 14px;font-weight:600;color:var(--muted);white-space:nowrap}
.seg button[aria-pressed="true"]{background:var(--accent);color:var(--accent-ink)}
.seg button small{display:block;font-size:11px;font-weight:500;opacity:.75}

/* Barra */
.bar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;margin-bottom:14px}
.bar .grp{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.btn{border:1px solid var(--line);background:var(--surface);border-radius:11px;padding:8px 13px;font-weight:600;font-size:14px;display:inline-flex;align-items:center;gap:6px}
.btn:hover{border-color:var(--muted)}
.btn.primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.btn.icon{padding:8px 11px}
.btn.ghost{background:transparent}
.tabs{display:inline-flex;border-bottom:1px solid var(--line);gap:4px}
.tabs button{border:0;background:none;padding:9px 12px;font-weight:600;color:var(--muted);border-bottom:2px solid transparent;margin-bottom:-1px}
.tabs button[aria-selected="true"]{color:var(--ink);border-color:var(--ink)}
.tabs .count{font-size:11px;background:var(--surface-2);border:1px solid var(--line);border-radius:999px;padding:0 6px;margin-left:4px;color:var(--muted)}
select.weeksel{border:1px solid var(--line);background:var(--surface);border-radius:11px;padding:8px 10px;font-weight:600;max-width:100%}
details.menu{position:relative}
details.menu summary{list-style:none}
details.menu summary::-webkit-details-marker{display:none}
details.menu .pop{position:absolute;right:0;top:calc(100% + 6px);background:var(--surface);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);padding:6px;min-width:260px;z-index:15;display:grid}
details.menu .pop button,details.menu .pop label{border:0;background:none;text-align:left;padding:9px 10px;border-radius:9px;font-weight:500;font-size:14px;cursor:pointer}
details.menu .pop button:hover,details.menu .pop label:hover{background:var(--surface-2)}
details.menu .pop hr{border:0;border-top:1px solid var(--line-soft);margin:4px 0}

/* Filtros */
.filters{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}
.chip{border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:5px 11px 5px 9px;font-size:13px;font-weight:600;display:inline-flex;gap:7px;align-items:center;color:var(--ink)}
.chip i{width:10px;height:10px;border-radius:3px;background:var(--c,var(--muted));display:inline-block}
.chip[aria-pressed="false"]{opacity:.45;text-decoration:line-through}

/* Banners */
.banners{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:10px;margin-bottom:14px}
.banner{background:var(--accent);color:var(--accent-ink);border-radius:16px;padding:12px 16px;display:flex;gap:4px 12px;align-items:baseline;flex-wrap:wrap;font-size:14px;min-width:0}
.banner.alt{background:var(--surface);color:var(--ink);border:1px solid var(--line)}
.banner .lbl{font-size:11px;text-transform:uppercase;letter-spacing:.1em;opacity:.7;font-weight:700;width:100%}
.banner b{font-family:var(--f-display);font-weight:600;font-size:17px;letter-spacing:-.01em}
.banner .when{opacity:.8}
.alert{border:1px solid var(--hol);background:var(--hol-soft);color:var(--ink);border-radius:14px;padding:10px 14px;font-size:13.5px;margin-bottom:12px}
.alert b{color:var(--hol)}

/* Layout principal */
.layout{display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:20px;align-items:start}
@media(max-width:1180px){.layout{grid-template-columns:minmax(0,1fr)}}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:20px;box-shadow:var(--shadow);padding:18px;min-width:0}
.weekhead{display:flex;justify-content:space-between;gap:10px 16px;flex-wrap:wrap;align-items:flex-start;margin-bottom:14px}
.weekhead h2{font-family:var(--f-display);font-weight:800;font-size:24px;letter-spacing:-.02em;margin:0;text-wrap:balance}
.weekhead .range{font-size:13px;color:var(--muted);font-weight:600;margin-top:2px}
.pills{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.pill{font-size:12px;font-weight:600;border-radius:999px;padding:3px 10px;background:var(--surface-2);border:1px solid var(--line);color:var(--muted)}
.pill.hol{background:var(--hol-soft);border-color:transparent;color:var(--hol)}
.pill.exam{background:color-mix(in srgb,var(--k-examen) 12%,var(--surface));border-color:transparent;color:var(--k-examen)}
.pill.vac{background:var(--surface-2)}
.navbtns{display:flex;gap:6px;flex-wrap:wrap}

/* Calendario semanal */
.calwrap{overflow-x:auto;border:1px solid var(--line);border-radius:16px}
.cal{display:grid;grid-template-columns:58px repeat(5,minmax(160px,1fr));min-width:880px;background:var(--surface)}
.cal .corner,.cal .dh{background:var(--surface-2);border-bottom:1px solid var(--line)}
.cal .dh{border-left:1px solid var(--line);padding:9px 10px;display:flex;gap:8px;align-items:baseline}
.cal .dh .dn{font-family:var(--f-display);font-weight:800;font-size:22px;letter-spacing:-.02em;line-height:1}
.cal .dh .dw{font-size:12px;text-transform:uppercase;letter-spacing:.08em;font-weight:700;color:var(--muted)}
.cal .dh.today .dn{background:var(--now);color:#fff;border-radius:8px;padding:2px 6px}
.cal .ad{border-left:1px solid var(--line);border-bottom:1px solid var(--line);padding:5px;display:flex;flex-direction:column;gap:4px;min-height:34px;background:var(--surface)}
.cal .adl{border-bottom:1px solid var(--line);font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;font-weight:700;padding:8px 6px;text-align:right}
.holtag{font-size:11.5px;font-weight:700;color:var(--hol);background:var(--hol-soft);border-radius:7px;padding:3px 7px;line-height:1.25}
.times{position:relative;height:896px}
.times span{position:absolute;right:8px;transform:translateY(-7px);font:500 11px var(--f-mono);color:var(--muted)}
.col{position:relative;height:896px;border-left:1px solid var(--line);background:repeating-linear-gradient(to bottom,transparent 0,transparent 63px,var(--line-soft) 63px,var(--line-soft) 64px)}
.col.holbg{background:repeating-linear-gradient(135deg,var(--hol-soft) 0 7px,transparent 7px 15px)}
.col.off{background-color:var(--surface-2)}
.nowline{position:absolute;left:0;right:0;height:2px;background:var(--now);z-index:4}
.nowline::before{content:"";position:absolute;left:-5px;top:-4px;width:10px;height:10px;border-radius:50%;background:var(--now)}

.ev{position:absolute;border-radius:10px;padding:5px 8px 5px 10px;overflow:hidden;cursor:pointer;border:0;text-align:left;background:var(--soft);color:var(--ink);box-shadow:inset 3px 0 0 var(--c);transition:transform .12s,box-shadow .12s;z-index:2}
.ev:hover{transform:translateY(-1px);box-shadow:inset 3px 0 0 var(--c),0 6px 16px rgba(20,27,45,.14);z-index:3}
.ev .t{font:700 11px var(--f-mono);color:var(--c);display:flex;justify-content:space-between;gap:4px}
.ev .n{font-weight:700;font-size:12.5px;line-height:1.15;margin-top:2px}
.ev .m{font-size:11px;color:var(--muted);margin-top:2px;line-height:1.2}
.ev.ufv,.mev.ufv{--c:var(--ufv);--soft:var(--ufv-soft)}
.ev.esic,.mev.esic{--c:var(--esic);--soft:var(--esic-soft)}
.ev.meeting,.mev.meeting{--c:var(--meet);--soft:var(--meet-soft)}
.ev.personal,.mev.personal{--c:var(--personal);--soft:var(--personal-soft)}
.ev.personal .n{font-weight:600;color:var(--muted)}
.ev.hito{background:var(--surface);box-shadow:inset 0 0 0 1.5px var(--c);border-radius:10px}
.ev.hito:hover{box-shadow:inset 0 0 0 1.5px var(--c),0 6px 16px rgba(20,27,45,.14)}
.ev.clash{outline:2px dashed var(--hol);outline-offset:-2px}
@media(min-width:761px){#calendar .ev,#calendar .ad .kchip{touch-action:none;cursor:grab}}
.ev .rs{position:absolute;left:0;right:0;bottom:0;height:8px;cursor:ns-resize}
.ev .rs::after{content:"";position:absolute;left:50%;bottom:2px;width:22px;height:3px;margin-left:-11px;border-radius:2px;background:var(--c);opacity:0;transition:opacity .12s}
.ev:hover .rs::after{opacity:.55}
.ev.dragging,.kchip.dragging{z-index:20;cursor:grabbing;transform:none;box-shadow:inset 3px 0 0 var(--c),0 14px 32px rgba(20,27,45,.28);opacity:.95;transition:none}
.ev.hito.dragging{box-shadow:inset 0 0 0 1.5px var(--c),0 14px 32px rgba(20,27,45,.28)}
body.isdragging{user-select:none;cursor:grabbing}
.col.droptarget,.ad.droptarget{background-color:color-mix(in srgb,var(--focus) 7%,transparent)}
.dragtip{position:fixed;z-index:50;pointer-events:none;background:var(--accent);color:var(--accent-ink);font:700 12.5px var(--f-mono);padding:6px 10px;border-radius:9px;box-shadow:var(--shadow);white-space:nowrap}
.toast{display:flex;gap:12px;align-items:center}
.toast button{border:0;background:transparent;color:inherit;font-weight:800;text-decoration:underline;padding:0}
.ev.done,.kchip.done,.kitem.done{opacity:.55}
.ev.done .n,.kchip.done span,.kitem.done .kt{text-decoration:line-through}
.k-tfg{--c:var(--k-tfg)}.k-tfm{--c:var(--k-tfm)}.k-delegados{--c:var(--k-delegados)}.k-practicas{--c:var(--k-practicas)}.k-examen{--c:var(--k-examen)}.k-actas{--c:var(--k-actas)}.k-tutoria{--c:var(--k-tutoria)}.k-otro{--c:var(--k-otro)}
.kchip{border:0;text-align:left;font-size:11.5px;font-weight:700;border-radius:7px;padding:3px 7px;background:color-mix(in srgb,var(--c) 14%,var(--surface));color:var(--ink);display:flex;gap:6px;align-items:center;line-height:1.2;width:100%;cursor:pointer}
.kchip::before{content:"";width:7px;height:7px;transform:rotate(45deg);background:var(--c);flex:none}
.kchip span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}
.empty-week{position:absolute;inset:40% 10px auto;text-align:center;color:var(--muted);font-size:13px}

/* Lista móvil */
.mlist{display:none}
.mday{border:1px solid var(--line);border-radius:16px;padding:12px;margin-bottom:10px;background:var(--surface)}
.mday.today{border-color:var(--now);border-width:2px}
.mday h3{margin:0 0 8px;font-family:var(--f-display);font-size:18px;font-weight:800;letter-spacing:-.01em;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.mday h3 .tp{font:700 10px var(--f-body);background:var(--now);color:#fff;border-radius:999px;padding:2px 8px;letter-spacing:.06em}
.mev{display:block;width:100%;border:0;text-align:left;border-radius:10px;padding:8px 10px;margin-top:6px;background:var(--soft);box-shadow:inset 3px 0 0 var(--c);cursor:pointer}
.mev .t{font:700 12px var(--f-mono);color:var(--c)}
.mev .n{font-weight:700;font-size:14px}
.mev small{color:var(--muted);font-size:12px}
.mev.hito{background:var(--surface);box-shadow:inset 0 0 0 1.5px var(--c)}
.mempty{color:var(--muted);font-size:13px}

/* Estadísticas */
.stats{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;margin-top:14px}
.stat{border:1px solid var(--line);border-radius:14px;padding:10px 12px;background:var(--surface-2)}
.stat b{font-family:var(--f-display);font-weight:800;font-size:22px;display:block;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
.stat span{font-size:12px;color:var(--muted)}

/* Mes */
.mgrid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));border:1px solid var(--line);border-radius:16px;overflow:hidden}
.mgrid .mh{background:var(--surface-2);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);padding:8px;border-bottom:1px solid var(--line)}
.mc{min-height:118px;border-right:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft);padding:6px;display:flex;flex-direction:column;gap:4px;cursor:pointer;background:var(--surface);position:relative;min-width:0}
.mc:hover{background:var(--surface-2)}
.mc.out{opacity:.35}
.mc.we{background:var(--surface-2)}
.mc.hol{background:repeating-linear-gradient(135deg,var(--hol-soft) 0 6px,transparent 6px 13px)}
.mc .top{display:flex;justify-content:space-between;align-items:center;gap:4px}
.mc .d{font-family:var(--f-display);font-weight:800;font-size:16px}
.mc.today .d{background:var(--now);color:#fff;border-radius:7px;padding:0 6px}
.mc .add{border:0;background:none;color:var(--muted);font-size:16px;line-height:1;padding:0 4px;border-radius:6px;opacity:0}
.mc:hover .add,.mc .add:focus-visible{opacity:1}
.mc .exb{position:absolute;left:0;right:0;top:0;height:3px;background:var(--k-examen)}
.dots{display:flex;gap:4px;flex-wrap:wrap}
.dots span{font:700 10.5px var(--f-mono);border-radius:6px;padding:1px 5px;background:var(--soft);color:var(--c)}
.dots .ufv{--c:var(--ufv);--soft:var(--ufv-soft)}.dots .esic{--c:var(--esic);--soft:var(--esic-soft)}.dots .meeting{--c:var(--meet);--soft:var(--meet-soft)}
.mc .holtag{font-size:10.5px;padding:2px 5px}
.more{font-size:11px;color:var(--muted);font-weight:600}
.monthtitle{font-family:var(--f-display);font-weight:800;font-size:24px;letter-spacing:-.02em;margin:0}

/* Fechas clave */
.quick{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}
.quick button{border:1px solid color-mix(in srgb,var(--c) 40%,var(--line));background:color-mix(in srgb,var(--c) 9%,var(--surface));color:var(--ink);border-radius:12px;padding:9px 13px;font-weight:700;font-size:14px;display:inline-flex;gap:8px;align-items:center}
.quick button::before{content:"+";color:var(--c);font-weight:800;font-size:16px;line-height:1}
.ktoolbar{display:flex;flex-wrap:wrap;gap:8px;justify-content:space-between;align-items:center;margin-bottom:10px}
.mgroup{margin-top:16px}
.mgroup h3{font-size:12px;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);margin:0 0 8px;font-weight:700}
.kitem{display:grid;grid-template-columns:62px minmax(0,1fr) auto;gap:14px;align-items:center;border:1px solid var(--line);border-radius:14px;padding:10px 12px;margin-bottom:8px;background:var(--surface);cursor:pointer;box-shadow:inset 4px 0 0 var(--c)}
.kitem:hover{border-color:var(--c)}
.kdate{text-align:center;line-height:1}
.kdate b{font-family:var(--f-display);font-weight:800;font-size:26px;display:block;letter-spacing:-.03em}
.kdate small{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);font-weight:700}
.kt{font-weight:700;font-size:15px}
.kmeta{font-size:12.5px;color:var(--muted);display:flex;gap:4px 10px;flex-wrap:wrap;margin-top:2px}
.ktype{font-size:11px;font-weight:700;color:var(--c);text-transform:uppercase;letter-spacing:.06em}
.kright{display:flex;flex-direction:column;align-items:flex-end;gap:6px}
.countdown{font:700 12px var(--f-mono);color:var(--muted);white-space:nowrap}
.countdown.soon{color:var(--hol)}
.donebox{display:flex;gap:6px;align-items:center;font-size:12px;color:var(--muted)}
.emptybox{border:1.5px dashed var(--line);border-radius:14px;padding:20px;text-align:center;color:var(--muted);font-size:14px}

/* Lateral */
aside{display:grid;gap:16px}
aside h3{font-family:var(--f-display);font-weight:800;font-size:17px;margin:0 0 10px;letter-spacing:-.01em}
.side-k{display:grid;grid-template-columns:44px minmax(0,1fr);gap:10px;align-items:center;padding:8px 0;border-top:1px solid var(--line-soft);cursor:pointer}
.side-k:first-of-type{border-top:0}
.side-k .kdate b{font-size:20px}
.side-k .kt{font-size:13.5px;line-height:1.25}
.side-k .kmeta{font-size:12px}
.fixed{display:grid;gap:8px}
.fixed .row{border:1px solid var(--line);border-radius:12px;padding:9px 11px;font-size:13px}
.fixed .row b{display:block;font-size:13.5px}
.fixed .row .a{display:flex;gap:6px;margin-top:6px;flex-wrap:wrap}
.fixed .row .a button{font-size:12px;padding:4px 9px;border-radius:8px}
.legend{display:grid;grid-template-columns:1fr 1fr;gap:6px 10px;font-size:12.5px}
.legend span{display:flex;gap:7px;align-items:center}
.legend i{width:10px;height:10px;border-radius:3px;background:var(--c);flex:none}
.legend i.d{transform:rotate(45deg);border-radius:1px;width:8px;height:8px}
.foot{font-size:12.5px;color:var(--muted);line-height:1.5;margin-top:14px}
.srcnote{font-size:12.5px;color:var(--muted);line-height:1.5}
.srcnote summary{cursor:pointer;font-weight:700;color:var(--ink)}

/* Modal */
.modalwrap{position:fixed;inset:0;background:rgba(10,14,22,.55);display:flex;align-items:center;justify-content:center;padding:16px;z-index:30;backdrop-filter:blur(3px)}
.modal{background:var(--surface);border:1px solid var(--line);border-radius:22px;padding:22px;max-width:640px;width:100%;max-height:92vh;overflow:auto;box-shadow:var(--shadow)}
.modal h2{font-family:var(--f-display);font-weight:800;margin:0 0 4px;letter-spacing:-.02em}
.modal .sub{color:var(--muted);font-size:13px;margin-bottom:14px}
.form{display:grid;grid-template-columns:1fr 1fr;gap:10px 12px}
.form .full{grid-column:1/-1}
.form label{font-size:12px;font-weight:700;color:var(--muted);display:block;margin-bottom:3px}
.form input,.form select,.form textarea{width:100%;padding:9px 10px;border:1px solid var(--line);border-radius:10px;background:var(--surface-2)}
.form textarea{min-height:72px;resize:vertical}
.form .check{display:flex;gap:8px;align-items:center;font-size:14px;font-weight:600;color:var(--ink)}
.form .check input{width:auto}
.actions{display:flex;gap:8px;justify-content:space-between;flex-wrap:wrap;margin-top:16px}
.actions .r{display:flex;gap:8px;flex-wrap:wrap}
.btn.danger{color:var(--hol);border-color:color-mix(in srgb,var(--hol) 40%,var(--line))}
.confirm{display:flex;gap:8px;align-items:center;flex-wrap:wrap;font-size:13px;color:var(--hol);font-weight:600}
.toast{position:fixed;left:50%;bottom:max(20px,env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--accent);color:var(--accent-ink);padding:10px 16px;border-radius:12px;font-weight:600;font-size:14px;z-index:40;box-shadow:var(--shadow)}

@media(max-width:760px){
  header.top{padding-block:18px 12px}
  .seg{width:100%}.seg button{flex:1;padding:8px 4px;white-space:normal;font-size:13px;line-height:1.2}.seg button small{display:none}
  .calwrap{display:none}.mlist{display:block}
  .stats{grid-template-columns:repeat(2,minmax(0,1fr))}
  .form{grid-template-columns:1fr}
  .panel{padding:12px;border-radius:16px}
  .mc{min-height:64px;padding:4px}
  .mc .kchip span,.mc .holtag{display:none}
  .mc .kchip{width:auto;padding:3px}
  .mc .chips{display:flex;gap:2px;flex-wrap:wrap}
  .dots span{font-size:9.5px;padding:0 3px}
  .kitem{grid-template-columns:48px minmax(0,1fr);}
  .kitem .kright{grid-column:2;flex-direction:row;align-items:center;justify-content:space-between}
  .legend{grid-template-columns:1fr}
}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
@media print{@page{size:A4 landscape;margin:8mm}body{background:#fff}.bar,.filters,aside,.banners,.mlist,.toast{display:none!important}.calwrap{display:block!important}.layout{display:block}.panel{box-shadow:none}}
</style>
</head>
<body>
<div class="wrap">
<header class="top">
  <div>
    <div class="eyebrow"><span><span class="dot" style="background:var(--ufv)"></span> UFV</span><span><span class="dot" style="background:var(--esic)"></span> ESIC</span><span>Curso 2026–27 · Eduar S. Ramírez Riveros</span></div>
    <h1>Horario docente <em>UFV + ESIC</em></h1>
  </div>
  <div class="seg" role="group" aria-label="Cuatrimestre" id="semSeg">
    <button data-sem="1" type="button">1.er cuatrimestre<small>sep – ene</small></button>
    <button data-sem="2" type="button">2.º cuatrimestre<small>ene – jul</small></button>
    <button data-sem="all" type="button">Curso completo<small>sep – jul</small></button>
  </div>
</header>

<div class="bar">
  <div class="tabs" role="tablist" id="viewTabs">
    <button role="tab" data-view="week" type="button">Semana</button>
    <button role="tab" data-view="month" type="button">Mes</button>
    <button role="tab" data-view="keys" type="button">Fechas clave <span class="count" id="keyCount">0</span></button>
  </div>
  <div class="grp">
    <button class="btn" type="button" onclick="goToday()">Hoy</button>
    <button class="btn primary" type="button" onclick="newHito()">+ Fecha clave</button>
    <details class="menu" id="moreMenu">
      <summary class="btn">Exportar y más ▾</summary>
      <div class="pop">
        <button type="button" onclick="downloadWeekICS()">Semana visible al móvil (.ics)</button>
        <button type="button" onclick="downloadRangeICS()">Todo el filtro actual (.ics)</button>
        <button type="button" onclick="downloadHitosICS()">Solo fechas clave (.ics)</button>
        <hr>
        <button type="button" onclick="addEvent()">Añadir bloque al horario</button>
        <hr>
        <button type="button" onclick="exportBackup()">Guardar copia de seguridad (.json)</button>
        <label for="importFile">Restaurar copia de seguridad…</label>
        <input type="file" id="importFile" accept="application/json,.json" hidden>
      </div>
    </details>
  </div>
</div>

<div class="filters" id="filters"></div>
<div class="banners" id="banners"></div>
<div id="clashAlert"></div>

<div class="layout">
  <main class="panel" id="mainPanel">
    <section id="weekView">
      <div class="weekhead">
        <div>
          <h2 id="weekTitle"></h2>
          <div class="range" id="weekRange"></div>
          <div class="pills" id="weekPills"></div>
        </div>
        <div class="navbtns">
          <button class="btn icon" type="button" onclick="prevWeek()" aria-label="Semana anterior">←</button>
          <select class="weeksel" id="weekSelect" aria-label="Elegir semana"></select>
          <button class="btn icon" type="button" onclick="nextWeek()" aria-label="Semana siguiente">→</button>
        </div>
      </div>
      <div class="calwrap"><div class="cal" id="calendar"></div></div>
      <div class="mlist" id="mobileList"></div>
      <div class="stats" id="stats"></div>
    </section>

    <section id="monthView" hidden>
      <div class="weekhead">
        <h2 class="monthtitle" id="monthTitle"></h2>
        <div class="navbtns">
          <button class="btn icon" type="button" onclick="moveMonth(-1)" aria-label="Mes anterior">←</button>
          <button class="btn icon" type="button" onclick="moveMonth(1)" aria-label="Mes siguiente">→</button>
        </div>
      </div>
      <div class="mgrid" id="monthGrid"></div>
      <div class="foot">Pulsa un día para abrir su semana. El botón + de cada casilla crea una fecha clave en ese día. La franja roja superior marca periodo de exámenes.</div>
    </section>

    <section id="keysView" hidden>
      <div class="quick" id="quickAdd"></div>
      <div class="ktoolbar">
        <div class="filters" id="typeFilters" style="margin:0"></div>
        <label class="donebox"><input type="checkbox" id="showPast"> Mostrar pasadas</label>
      </div>
      <div id="keyList"></div>
    </section>

    <div class="foot">Arrastra cualquier bloque para cambiarlo de día u hora (salta de 15 en 15 min) y tira del borde inferior para alargarlo; mientras lo mueves verás el día y la hora. Pulsa un bloque para editarlo (aula, hora, notas). Los cambios y las fechas clave se guardan en este navegador; usa <b>Guardar copia</b> para pasarlos a otro dispositivo. Las exportaciones .ics incluyen aula, grupo y aviso.</div>
  </main>

  <aside>
    <section class="panel">
      <h3>Próximas fechas clave</h3>
      <div id="sideKeys"></div>
    </section>
    <section class="panel">
      <h3>Sin horario fijo · 2.º cuatri</h3>
      <div class="fixed" id="fixedList"></div>
    </section>
    <section class="panel">
      <h3>Leyenda</h3>
      <div class="legend" id="legend"></div>
    </section>
    <section class="panel srcnote">
      <details><summary>Fuentes y avisos</summary><div id="sourceNote" style="margin-top:8px"></div></details>
    </section>
  </aside>
</div>
</div>

<!-- Modal bloque de horario -->
<div class="modalwrap" id="evModal" hidden>
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="evTitle">
    <h2 id="evTitle">Editar bloque</h2>
    <div class="sub">Los cambios solo afectan a este día. Para cambios permanentes de aula, edita cada sesión o avísame y actualizo la plantilla.</div>
    <div class="form">
      <div><label for="f_title">Título</label><input id="f_title"></div>
      <div><label for="f_inst">Institución</label><select id="f_inst"><option>UFV</option><option>ESIC</option><option>Personal</option></select></div>
      <div><label for="f_date">Fecha</label><input id="f_date" type="date"></div>
      <div><label for="f_kind">Tipo</label><select id="f_kind"><option value="class">Clase</option><option value="meeting">Reunión</option><option value="personal">Personal</option></select></div>
      <div><label for="f_start">Inicio</label><input id="f_start" type="time"></div>
      <div><label for="f_end">Fin</label><input id="f_end" type="time"></div>
      <div><label for="f_group">Grupo</label><input id="f_group"></div>
      <div><label for="f_room">Aula</label><input id="f_room" placeholder="Ej.: Aula 1,3 (Edificio O)"></div>
      <div><label for="f_reminder">Aviso (minutos antes)</label><input id="f_reminder" type="number" min="0" value="30"></div>
      <div><label for="f_place">Lugar adicional</label><input id="f_place" placeholder="Campus, edificio…"></div>
      <div class="full"><label for="f_notes">Notas</label><textarea id="f_notes"></textarea></div>
    </div>
    <div class="actions">
      <div id="evDelZone"><button class="btn danger" type="button" onclick="askDelete('ev')">Quitar este bloque</button></div>
      <div class="r"><button class="btn" type="button" onclick="closeModals()">Cancelar</button><button class="btn primary" type="button" onclick="saveEvent()">Guardar</button></div>
    </div>
  </div>
</div>

<!-- Modal fecha clave -->
<div class="modalwrap" id="hModal" hidden>
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="hTitle">
    <h2 id="hTitle">Nueva fecha clave</h2>
    <div class="sub" id="hSub">Entregas de TFG/TFM, reuniones con delegados, seguimiento de prácticas, exámenes…</div>
    <div class="form">
      <div><label for="h_type">Tipo</label><select id="h_type"></select></div>
      <div><label for="h_inst">Institución</label><select id="h_inst"><option value="UFV">UFV</option><option value="ESIC">ESIC</option><option value="Ambas">Ambas</option><option value="">—</option></select></div>
      <div class="full"><label for="h_title">Título</label><input id="h_title"></div>
      <div><label for="h_date">Fecha</label><input id="h_date" type="date"></div>
      <div style="display:flex;align-items:flex-end"><label class="check" for="h_allday" style="margin:0 0 9px"><input type="checkbox" id="h_allday"> Todo el día</label></div>
      <div class="htime"><label for="h_start">Inicio</label><input id="h_start" type="time"></div>
      <div class="htime"><label for="h_end">Fin</label><input id="h_end" type="time"></div>
      <div><label for="h_who">Alumnos / grupo</label><input id="h_who" placeholder="Ej.: 4.º E · delegada Marta G."></div>
      <div><label for="h_place">Lugar</label><input id="h_place" placeholder="Despacho, Teams, aula…"></div>
      <div><label for="h_reminder">Aviso</label><select id="h_reminder"><option value="0">Sin aviso</option><option value="15">15 min antes</option><option value="30">30 min antes</option><option value="60">1 hora antes</option><option value="1440">1 día antes</option><option value="2880">2 días antes</option><option value="10080">1 semana antes</option></select></div>
      <div><label for="h_repeat">Repetir</label><select id="h_repeat"><option value="none">No se repite</option><option value="weekly">Cada semana</option><option value="biweekly">Cada 2 semanas</option><option value="monthly">Cada mes</option></select></div>
      <div id="h_untilWrap"><label for="h_until">Repetir hasta</label><input id="h_until" type="date"></div>
      <div style="display:flex;align-items:flex-end"><label class="check" for="h_done" style="margin:0 0 9px"><input type="checkbox" id="h_done"> Hecho / entregado</label></div>
      <div class="full"><label for="h_notes">Notas</label><textarea id="h_notes" placeholder="Requisitos de la entrega, orden del día, documentos…"></textarea></div>
    </div>
    <div class="actions">
      <div id="hDelZone"><button class="btn danger" type="button" onclick="askDelete('h')">Eliminar</button></div>
      <div class="r"><button class="btn" type="button" onclick="closeModals()">Cancelar</button><button class="btn primary" type="button" onclick="saveHito()">Guardar</button></div>
    </div>
  </div>
</div>
<div class="toast" id="toast" hidden></div>
<div class="dragtip" id="dragTip" hidden></div>

