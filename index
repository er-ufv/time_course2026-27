      else html+=`<button type="button" class="mev ${cls(e)}" data-k="${h(e._key)}" onclick="openEditKey(this.dataset.k)"><div class="t">${e.start}–${e.end}</div><div class="n">${h(e.title)}</div><small>${e.kind==='personal'?'':e.inst}${e.room?' · '+h(e.room):(e.inst==='UFV'&&e.kind==='class'?' · aula pendiente':'')}${e.group&&e.kind==='class'?' · '+h(e.group):''}</small></button>`;
    });
    if(!items.length&&!x)html+='<div class="mempty">Sin clases</div>';
    html+='</div>'}
