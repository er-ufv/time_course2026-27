document.addEventListener('pointermove',e=>{
  if(!drag)return;const dx=e.clientX-drag.x0,dy=e.clientY-drag.y0;
  if(!drag.moved){if(Math.hypot(dx,dy)<5)return;drag.moved=true;drag.el.classList.add('dragging');document.body.classList.add('isdragging')}
  e.preventDefault();
  let tgt=drag.host;
  if(!drag.resize){const cols=[...document.querySelectorAll(drag.isChip?'#calendar .ad':'#calendar .col')];tgt=cols.find(c=>{const r=c.getBoundingClientRect();return e.clientX>=r.left&&e.clientX<r.right})||drag.el.parentNode}
  document.querySelectorAll('#calendar .droptarget').forEach(c=>c!==tgt&&c.classList.remove('droptarget'));tgt.classList.add('droptarget');
  if(tgt!==drag.el.parentNode)tgt.appendChild(drag.el);
  drag.date=tgt.dataset.date;
  if(drag.isChip){showTip(e,`${dayLbl(drag.date)} · todo el día`);return}
  if(drag.resize){drag.s=drag.s0;drag.en=Math.max(drag.s0+SNAP,Math.min(ENDH*60,snapM(drag.e0+dy/PXH*60)))}
  else{const dur=drag.e0-drag.s0;let s=snapM(drag.s0+dy/PXH*60);s=Math.max(STARTH*60,Math.min(ENDH*60-dur,s));drag.s=s;drag.en=s+dur}
  const el=drag.el;el.style.left='4px';el.style.width='calc(100% - 8px)';
  el.style.top=((drag.s-STARTH*60)/60*PXH)+'px';el.style.height=Math.max(22,(drag.en-drag.s)/60*PXH-4)+'px';
  const ts=el.querySelector('.t span');if(ts)ts.textContent=hm(drag.s)+'–'+hm(drag.en);
  showTip(e,`${dayLbl(drag.date)} · ${hm(drag.s)}–${hm(drag.en)}`);
});
function endDrag(cancel){
  if(!drag)return;const d=drag;drag=null;
  document.querySelectorAll('#calendar .droptarget').forEach(c=>c.classList.remove('droptarget'));
  document.body.classList.remove('isdragging');$('dragTip').hidden=true;
  if(!d.moved)return;
  dragJust=true;setTimeout(()=>dragJust=false,80);
  if(cancel||(d.date===d.orig&&d.s===d.s0&&d.en===d.e0)){render();return}
  commitMove(d);
}
document.addEventListener('pointerup',()=>endDrag(false));
document.addEventListener('pointercancel',()=>endDrag(true));
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&drag){drag.moved?endDrag(true):(drag=null)}});
function showTip(e,txt){const t=$('dragTip');t.textContent=txt;t.hidden=false;t.style.left=(e.clientX+14)+'px';t.style.top=(e.clientY+14)+'px'}
function commitMove(d){
  const when=d.isChip?dayLbl(d.date):`${dayLbl(d.date)} · ${hm(d.s)}–${hm(d.en)}`;
  if(d.el.dataset.k){
    const k=d.el.dataset.k,ev=findEvent(k);if(!ev){render();return}
    const had=Object.prototype.hasOwnProperty.call(custom,k),prev=had?{...custom[k]}:null;
    custom[k]={...(custom[k]||{}),title:ev.title,inst:ev.inst,kind:ev.kind,group:ev.group||'',room:ev.room||'',reminder:ev.reminder??30,place:ev.place||'',notes:ev.notes||'',date:d.date,start:hm(d.s),end:hm(d.en)};
    LS.set('eduarHorario15w',custom);render();
    toast(`${ev.title} → ${when}${k.startsWith('custom-')?'':' (solo este día)'}`,()=>{if(had)custom[k]=prev;else delete custom[k];LS.set('eduarHorario15w',custom)});
    return;
  }
  const id=d.el.dataset.h,x=allHitos().find(y=>y.id===id);if(!x){render();return}
  const prevUser=hitos.find(y=>y.id===id),prev=prevUser?{...prevUser}:null;
  const nx={...x,date:addDays(x.date,daysBetween(d.orig,d.date))};
  if(!d.isChip){nx.start=hm(d.s);nx.end=hm(d.en)}
  upsertHito(nx);render();
  toast(`${x.title} → ${when}${x.repeat&&x.repeat!=='none'?' (toda la serie)':''}`,()=>{hitos=hitos.filter(y=>y.id!==id);if(prev)hitos.push(prev);LS.set('eduarHitos',hitos)});
}

/* ===================== INICIO ===================== */
document.querySelectorAll('#semSeg button').forEach(b=>b.onclick=()=>setSem(b.dataset.sem));
document.querySelectorAll('#viewTabs button').forEach(b=>b.onclick=()=>{prefs.view=b.dataset.view;savePrefs();render()});
$('weekSelect').onchange=()=>{weekIndex=Number($('weekSelect').value);render()};
$('showPast').onchange=e=>{prefs.past=e.target.checked;savePrefs();render()};
h_allday.onchange=syncHitoForm;h_repeat.onchange=syncHitoForm;
h_type.addEventListener('change',()=>{if(currentHito)return;const T=KT[h_type.value];if(Object.values(KT).some(v=>v.label===h_title.value)||!h_title.value)h_title.value=T.label;h_allday.checked=!!T.allDay;if(T.start){h_start.value=T.start;h_end.value=T.end}h_reminder.value=T.allDay?'1440':'30';syncHitoForm()});
document.querySelectorAll('.modalwrap').forEach(m=>m.addEventListener('click',e=>{if(e.target===m)closeModals()}));
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModals();if(e.target.matches('input,textarea,select'))return;if(e.key==='ArrowLeft'&&prefs.view==='week')prevWeek();if(e.key==='ArrowRight'&&prefs.view==='week')nextWeek()});
document.addEventListener('click',e=>{const m=$('moreMenu');if(m.open&&!m.contains(e.target))m.open=false});
fillTypes();
if(!prefs.sem){const t=todayIso();prefs.sem=t<DATA.sem['2'].from?'1':(t<=DATA.sem['2'].to?'2':'all')}
weekIndex=initialWeek();{const ms=monthsOf(prefs.sem),t=todayIso();monthIndex=Math.max(0,ms.findIndex(m=>m.slice(0,7)===t.slice(0,7)))}
render();
setInterval(()=>{if($('evModal').hidden&&$('hModal').hidden&&prefs.view==='week')render()},60000);
</script>
