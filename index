}
function renderStats(all,hs,w){
  const sum=k=>all.filter(e=>e.kind===k).reduce((a,e)=>a+min(e.end)-min(e.start),0)/60;
  let longest=0,useful=0;
  for(let i=0;i<5;i++){const d=addDays(w.start,i),ds=all.filter(e=>e.date===d&&e.kind!=='personal').sort((a,b)=>min(a.start)-min(b.start));let end=null;ds.forEach(e=>{if(end!==null){const g=min(e.start)-end;if(g>=30)useful+=g;longest=Math.max(longest,g)}end=Math.max(end??0,min(e.end))})}
  const n=s=>s.toFixed(1).replace('.',',');
  $('stats').innerHTML=`<div class="stat"><b>${n(sum('class'))} h</b><span>de clase</span></div><div class="stat"><b>${n(sum('meeting'))} h</b><span>de reuniones</span></div><div class="stat"><b>${hs.length}</b><span>fechas clave</span></div><div class="stat"><b>${n(useful/60)} h</b><span>huecos ≥ 30 min</span></div><div class="stat"><b>${n(longest/60)} h</b><span>hueco más largo</span></div>`;
}

