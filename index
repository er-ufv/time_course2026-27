/* ===================== FECHAS ===================== */
function dparse(s){return new Date(s+'T12:00:00')}
function iso(d){return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`}
function addDays(s,n){const d=dparse(s);d.setDate(d.getDate()+n);return iso(d)}
function todayIso(){return iso(new Date())}
function wday(s){return (dparse(s).getDay()+6)%7}
function mondayOf(s){return addDays(s,-wday(s))}
function min(t){const p=t.split(':').map(Number);return p[0]*60+p[1]}
function hm(m){return String(Math.floor(m/60)).padStart(2,'0')+':'+String(m%60).padStart(2,'0')}
function dShort(s){return dparse(s).toLocaleDateString('es-ES',{day:'numeric',month:'short'})}
function dLong(s){return dparse(s).toLocaleDateString('es-ES',{weekday:'long',day:'numeric',month:'long'})}
function dWk(s){return dparse(s).toLocaleDateString('es-ES',{weekday:'short'}).replace('.','')}
function daysBetween(a,b){return Math.round((dparse(b)-dparse(a))/864e5)}
function h(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}

/* ===================== MODELO ===================== */
function semOfDate(d){return d>=DATA.sem['2'].from?'2':'1'}
function inTeach(inst,d){const r=DATA.sem[semOfDate(d)].teach[inst];return !!r&&d>=r[0]&&d<=r[1]}
function holidayFor(inst,d){const x=DATA.holidays[d];if(!x)return null;if(inst==='UFV'&&x.ufv)return x;if(inst==='ESIC'&&x.esic)return x;return null}
function holScope(x){return x.ufv&&x.esic?'':(x.esic?' · solo ESIC':' · solo UFV')}
function periodsIn(a,b){return DATA.periods.filter(p=>p.from<=b&&p.to>=a)}
function isTeachingDay(d){return ['UFV','ESIC'].some(i=>inTeach(i,d)&&!holidayFor(i,d))}
function weeksOf(key){
  const sems=key==='all'?['1','2']:[key],out=[];
  sems.forEach(s=>{const S=DATA.sem[s];let ws=S.from,n=0;while(ws<=S.to){let teaching=false;for(let i=0;i<5;i++)if(isTeachingDay(addDays(ws,i)))teaching=true;if(teaching)n++;out.push({sem:s,start:ws,end:addDays(ws,6),n:teaching?n:null});ws=addDays(ws,7)}});
  return out;
}
function keyOf(e){return `${e.date}|${e.start}|${e.inst}|${e.title}`}
function cls(e){if(e.kind==='meeting')return'meeting';if(e.inst==='UFV')return'ufv';if(e.inst==='ESIC')return'esic';return'personal'}
function baseForDate(d){
  const wd=wday(d);if(wd>4)return[];const s=+semOfDate(d);
  return DATA.weekly.filter(x=>x.sem.includes(s)&&x.day===wd&&inTeach(x.inst,d)&&!holidayFor(x.inst,d)).map(x=>({...x,date:d,reminder:30,place:'',notes:''}));
}
function freeSlot(evs){
  const cands=['14:30','14:00','15:00','13:30','13:00','16:00','15:30','12:30'];
  for(const c of cands){const s=min(c),e=s+60;if(!evs.some(x=>min(x.start)<e&&min(x.end)>s))return[c,hm(e)]}
  return null;
}
function buildWeek(w){
  let arr=[];for(let i=0;i<5;i++)arr.push(...baseForDate(addDays(w.start,i)));
  let out=[];
  arr.forEach(e=>{const k=keyOf(e),c=custom[k];if(c?.deleted)return;out.push({...e,...(c||{}),_key:k})});
  Object.values(custom).filter(x=>x.added&&!x.deleted&&x.date>=w.start&&x.date<=w.end).forEach(x=>out.push({...x,_key:x._id}));
  out=out.filter(e=>e.date>=w.start&&e.date<=w.end);
  Object.entries(custom).forEach(([k,c])=>{if(c.added||c.deleted||!c.title||!c.date||!c.start)return;const bd=k.slice(0,10);if((bd<w.start||bd>w.end)&&c.date>=w.start&&c.date<=w.end)out.push({...c,_key:k})});
  for(let i=0;i<5;i++){
    const d=addDays(w.start,i),day=out.filter(e=>e.date===d&&e.kind!=='personal');
    if(!day.length)continue;
    const sl=freeSlot(day);if(!sl)continue;
    const e={date:d,start:sl[0],end:sl[1],title:'Comida',inst:'Personal',room:'',group:'',kind:'personal',reminder:0,place:'',notes:''};
    const k=`${d}|lunch`,c=custom[k];if(c?.deleted)continue;out.push({...e,...(c||{}),_key:k});
  }
  return out.sort((a,b)=>a.date.localeCompare(b.date)||min(a.start)-min(b.start));
}
function visible(e){
  const hide=prefs.hide;
  if(e.kind==='personal')return!hide.includes('personal');
  if(e.kind==='meeting')return!hide.includes('meeting');
  return!hide.includes(e.inst);
}

/* ---- Fechas clave ---- */
function allHitos(){const ids=new Set(hitos.map(x=>x.id));return DATA.seeds.filter(s=>!seedOff.includes(s.id)&&!ids.has(s.id)).map(s=>({...s,seed:true})).concat(hitos)}
function occurrences(x,from,to){
  const rep=x.repeat||'none',out=[];
  if(rep==='none'){if(x.date>=from&&x.date<=to)out.push({...x});return out}
  const until=x.until||DATA.sem['2'].to,base=dparse(x.date);let i=0,d=x.date;
  while(d<=until&&d<=to&&i<500){if(d>=from)out.push({...x,date:d,_occ:i});i++;
    if(rep==='weekly')d=addDays(x.date,7*i);else if(rep==='biweekly')d=addDays(x.date,14*i);else{const t=new Date(base);t.setMonth(base.getMonth()+i);d=iso(t)}}
  return out;
}
function hitosIn(from,to,force){
  if(!force&&prefs.hide.includes('hitos'))return[];
  return allHitos().flatMap(x=>occurrences(x,from,to)).sort((a,b)=>a.date.localeCompare(b.date)||(a.allDay?-1:b.allDay?1:min(a.start)-min(b.start)));
}
function hitoTime(x){return x.allDay?'Todo el día':`${x.start}–${x.end}`}

/* ===================== RENDER ===================== */
function rangeOf(key){return key==='all'?[DATA.sem['1'].from,DATA.sem['2'].to]:[DATA.sem[key].from,DATA.sem[key].to]}
function weekIdxFor(d,key){const ws=weeksOf(key);let i=ws.findIndex(w=>d>=w.start&&d<=w.end);return i}
function initialWeek(){const ws=weeksOf(prefs.sem),t=todayIso();for(let i=0;i<ws.length;i++)if(t<=ws[i].end)return i;return ws.length-1}
function render(){
  document.querySelectorAll('#semSeg button').forEach(b=>b.setAttribute('aria-pressed',b.dataset.sem===prefs.sem));
  document.querySelectorAll('#viewTabs button').forEach(b=>b.setAttribute('aria-selected',b.dataset.view===prefs.view));
  $('weekView').hidden=prefs.view!=='week';$('monthView').hidden=prefs.view!=='month';$('keysView').hidden=prefs.view!=='keys';
  const [a,b]=rangeOf(prefs.sem);$('keyCount').textContent=hitosIn(a>todayIso()?a:todayIso(),b,true).filter(x=>!x.done).length;
  renderFilters();renderBanners();
