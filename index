function esc(s){return String(s||'').replace(/\\/g,'\\\\').replace(/\n/g,'\\n').replace(/,/g,'\\,').replace(/;/g,'\\;')}
function stamp(){return new Date().toISOString().replace(/[-:]/g,'').replace(/\.\d+/,'')}
function icsLines(events,hs,name){
  const L=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//Horario Eduar//ES','CALSCALE:GREGORIAN','METHOD:PUBLISH','X-WR-CALNAME:'+esc(name),'X-WR-TIMEZONE:Europe/Madrid'],st=stamp();
  const alarm=(m,t)=>{if(m>0)L.push('BEGIN:VALARM','TRIGGER:-PT'+m+'M','ACTION:DISPLAY','DESCRIPTION:'+esc('Recordatorio: '+t),'END:VALARM')};
  events.forEach(e=>{const ds=e.date.replaceAll('-','');L.push('BEGIN:VEVENT','UID:'+ds+'-'+e.start.replace(':','')+'-'+esc((e.inst+e.title).replace(/\W/g,'').slice(0,24))+'@horario-eduar','DTSTAMP:'+st,'DTSTART:'+ds+'T'+e.start.replace(':','')+'00','DTEND:'+ds+'T'+e.end.replace(':','')+'00','SUMMARY:'+esc(e.title+' ['+e.inst+']'),'LOCATION:'+esc([e.inst,e.place,e.room].filter(Boolean).join(' · ')),'DESCRIPTION:'+esc([e.group,e.notes].filter(Boolean).join(' · ')));alarm(e.reminder,e.title);L.push('END:VEVENT')});
  hs.forEach(x=>{const ds=x.date.replaceAll('-','');L.push('BEGIN:VEVENT','UID:'+x.id+'-'+ds+'@horario-eduar','DTSTAMP:'+st);
    if(x.allDay)L.push('DTSTART;VALUE=DATE:'+ds,'DTEND;VALUE=DATE:'+addDays(x.date,1).replaceAll('-',''));else L.push('DTSTART:'+ds+'T'+x.start.replace(':','')+'00','DTEND:'+ds+'T'+x.end.replace(':','')+'00');
    L.push('SUMMARY:'+esc(x.title),'CATEGORIES:'+esc(KT[x.type]?.label||''),'LOCATION:'+esc([x.inst,x.place].filter(Boolean).join(' · ')),'DESCRIPTION:'+esc([KT[x.type]?.label,x.who,x.notes].filter(Boolean).join(' · ')));alarm(x.reminder,x.title);L.push('END:VEVENT')});
  L.push('END:VCALENDAR');return L.join('\r\n');
}
