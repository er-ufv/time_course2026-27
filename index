function renderFilters(){
  const items=[['UFV','UFV','var(--ufv)'],['ESIC','ESIC','var(--esic)'],['meeting','Reuniones UFV','var(--meet)'],['personal','Comida','var(--personal)'],['hitos','Fechas clave','var(--k-tfg)']];
  $('filters').innerHTML=items.map(([k,l,c])=>`<button type="button" class="chip" style="--c:${c}" aria-pressed="${!prefs.hide.includes(k)}" onclick="toggleHide('${k}')"><i></i>${l}</button>`).join('');
}
function toggleHide(k){prefs.hide=prefs.hide.includes(k)?prefs.hide.filter(x=>x!==k):[...prefs.hide,k];savePrefs();render()}
function nextClass(){
  const now=new Date(),t=iso(now),nm=now.getHours()*60+now.getMinutes();
  const ws=weeksOf('all');let i=ws.findIndex(w=>t<=w.end);if(i<0)return null;
  for(;i<ws.length;i++){for(const e of buildWeek(ws[i]).filter(e=>e.kind!=='personal')){if(e.date>t||(e.date===t&&min(e.start)>nm))return e}}
  return null;
}
function whenLabel(d){const t=todayIso();if(d===t)return'Hoy';if(d===addDays(t,1))return'Mañana';return dLong(d)}
function renderBanners(){
  const nc=nextClass(),t=todayIso(),nk=hitosIn(t,addDays(t,400)).filter(x=>!x.done)[0];
  let html='';
  if(nc)html+=`<div class="banner"><span class="lbl">Próxima clase</span><b>${h(nc.title)}</b><span class="when">${whenLabel(nc.date)} · ${nc.start}–${nc.end}${nc.room?' · '+h(nc.room):''} · ${nc.inst}</span></div>`;
  if(nk)html+=`<div class="banner alt k-${nk.type}" style="box-shadow:inset 4px 0 0 var(--c)"><span class="lbl">Próxima fecha clave · ${h(KT[nk.type]?.label||'')}</span><b>${h(nk.title)}</b><span class="when">${whenLabel(nk.date)} · ${hitoTime(nk)} · ${countdown(nk.date)}</span></div>`;
  $('banners').innerHTML=html;
}
function countdown(d){const n=daysBetween(todayIso(),d);if(n===0)return'hoy';if(n===1)return'mañana';if(n>0)return`en ${n} días`;if(n===-1)return'ayer';return`hace ${-n} días`}

function layoutLanes(items){
  items.sort((a,b)=>min(a.start)-min(b.start)||min(b.end)-min(a.end));
  let cl=[],cur=[],end=-1;
  items.forEach(it=>{const s=min(it.start);if(cur.length&&s>=end){cl.push(cur);cur=[];end=-1}cur.push(it);end=Math.max(end,min(it.end))});
  if(cur.length)cl.push(cur);
  cl.forEach(c=>{const lanes=[];c.forEach(it=>{let l=lanes.findIndex(e=>e<=min(it.start));if(l<0){l=lanes.length;lanes.push(0)}lanes[l]=min(it.end);it._lane=l});c.forEach(it=>it._lanes=lanes.length)});
}
function weekLabel(w){
  if(w.n)return`Semana lectiva ${w.n}`;
  const p=periodsIn(w.start,addDays(w.start,4));return p.length?p[0].name:'Semana sin docencia';
}
function renderWeek(){
  const ws=weeksOf(prefs.sem);weekIndex=Math.max(0,Math.min(weekIndex,ws.length-1));const w=ws[weekIndex];
  $('weekSelect').innerHTML=ws.map((x,i)=>`<option value="${i}">${prefs.sem==='all'?DATA.sem[x.sem].short+' · ':''}${x.n?'Sem. '+x.n:'—'} · ${dShort(x.start)} – ${dShort(addDays(x.start,4))}</option>`).join('');
  $('weekSelect').value=weekIndex;
  $('weekTitle').textContent=weekLabel(w);
  $('weekRange').textContent=`${DATA.sem[w.sem].label} · ${dLong(w.start)} – ${dLong(addDays(w.start,4))}`;
  const pills=[];
  for(let i=0;i<5;i++){const d=addDays(w.start,i),x=DATA.holidays[d];if(x)pills.push(`<span class="pill hol">${dWk(d)} ${dparse(d).getDate()} · ${h(x.name)}${holScope(x)}</span>`)}
  periodsIn(w.start,addDays(w.start,4)).forEach(p=>pills.push(`<span class="pill ${p.kind}">${h(p.name)} · ${dShort(p.from)}–${dShort(p.to)}</span>`));
  ['UFV','ESIC'].forEach(inst=>{const r=DATA.sem[w.sem].teach[inst];if(r[0]>w.start&&r[0]<=w.end)pills.push(`<span class="pill">Empiezan clases ${inst}: ${dWk(r[0])} ${dShort(r[0])}</span>`);if(r[1]>=w.start&&r[1]<w.end)pills.push(`<span class="pill">Último día lectivo ${inst}: ${dWk(r[1])} ${dShort(r[1])}</span>`)});
  $('weekPills').innerHTML=pills.join('');
  const all=buildWeek(w),es=all.filter(visible),hs=hitosIn(w.start,w.end);
  // conflictos
  const clashes=[];
  for(let i=0;i<5;i++){const d=addDays(w.start,i);const items=all.filter(e=>e.date===d&&e.kind==='class').concat(hs.filter(x=>x.date===d&&!x.allDay));
    for(let a=0;a<items.length;a++)for(let b=a+1;b<items.length;b++){const A=items[a],B=items[b];if(min(A.start)<min(B.end)&&min(B.start)<min(A.end)){A._clash=B._clash=true;clashes.push(`${dWk(d)} ${dparse(d).getDate()}: <b>${h(A.title)}</b> (${A.start}) y <b>${h(B.title)}</b> (${B.start})`)}}}
  $('clashAlert').innerHTML=clashes.length?`<div class="alert"><b>Solapamientos esta semana.</b> ${clashes.join(' · ')}</div>`:'';
  renderCalendar(es,hs,w);renderMobile(es,hs,w);renderStats(all,hs,w);
}
function evBlock(e,isH){
  const top=(min(e.start)-STARTH*60)/60*PXH,ht=Math.max(22,(min(e.end)-min(e.start))/60*PXH-4);
  const lanes=e._lanes||1,lane=e._lane||0;
  const style=`top:${top}px;height:${ht}px;left:calc(${lane/lanes*100}% + 4px);width:calc(${100/lanes}% - 8px)`;
  if(isH){return`<button type="button" class="ev hito k-${e.type}${e._clash?' clash':''}${e.done?' done':''}" style="${style}" data-h="${e.id}" data-s="${e.start}" data-e="${e.end}" onclick="if(!dragJust)openHito('${e.id}','${e.date}')"><div class="t"><span>${e.start}–${e.end}</span><span>◆</span></div><div class="n">${h(e.title)}</div><div class="m">${h(KT[e.type]?.label||'')}${e.who?' · '+h(e.who):''}</div><span class="rs" title="Arrastra para cambiar la duración"></span></button>`}
  const room=e.room?h(e.room):(e.inst==='UFV'&&e.kind==='class'?'aula pendiente':'');
  const meta=[e.kind==='personal'?'':e.inst,room,e.group&&e.kind!=='meeting'?h(e.group):''].filter(Boolean).join(' · ');
  return`<button type="button" class="ev ${cls(e)}${e._clash?' clash':''}" style="${style}" data-k="${h(e._key)}" data-s="${e.start}" data-e="${e.end}" onclick="if(!dragJust)openEditKey(this.dataset.k)"><div class="t"><span>${e.start}–${e.end}</span>${e.reminder?'<span aria-label="con aviso">•</span>':''}</div><div class="n">${h(e.title)}</div>${meta?`<div class="m">${meta}</div>`:''}<span class="rs" title="Arrastra para cambiar la duración"></span></button>`;
}
let weekCache=[];
function renderCalendar(es,hs,w){
  weekCache=es;const t=todayIso();let html='<div class="corner"></div>';
  for(let i=0;i<5;i++){const d=addDays(w.start,i);html+=`<div class="dh${d===t?' today':''}"><span class="dn">${dparse(d).getDate()}</span><span class="dw">${DAYS[i]}</span></div>`}
  html+='<div class="adl">Día</div>';
  for(let i=0;i<5;i++){const d=addDays(w.start,i),x=DATA.holidays[d];
    html+=`<div class="ad" data-date="${d}">${x?`<span class="holtag">${h(x.name)}${holScope(x)}</span>`:''}${hs.filter(k=>k.date===d&&k.allDay).map(k=>`<button type="button" class="kchip k-${k.type}${k.done?' done':''}" data-h="${k.id}" onclick="if(!dragJust)openHito('${k.id}','${k.date}')"><span>${h(k.title)}</span></button>`).join('')}</div>`}
  html+='<div class="times">';for(let hh=STARTH;hh<=ENDH;hh++)html+=`<span style="top:${(hh-STARTH)*PXH}px">${String(hh).padStart(2,'0')}:00</span>`;html+='</div>';
  const now=new Date(),nm=now.getHours()*60+now.getMinutes();
  for(let i=0;i<5;i++){const d=addDays(w.start,i),x=DATA.holidays[d];
    const items=es.filter(e=>e.date===d).map(e=>({...e,_h:false})).concat(hs.filter(k=>k.date===d&&!k.allDay).map(k=>({...k,_h:true})));
    layoutLanes(items);
    html+=`<div class="col${x?' holbg':''}${!isTeachingDay(d)&&!x?' off':''}" data-date="${d}">`;
    if(d===t&&nm>=STARTH*60&&nm<=ENDH*60)html+=`<div class="nowline" style="top:${(nm-STARTH*60)/60*PXH}px"></div>`;
    items.forEach(it=>html+=evBlock(it,it._h));
    if(i===2&&!es.length&&!hs.length)html+=`<div class="empty-week">Sin clases esta semana</div>`;
    html+='</div>'}
  $('calendar').innerHTML=html;
}
function renderMobile(es,hs,w){
  const t=todayIso();let html='';
  for(let i=0;i<5;i++){const d=addDays(w.start,i),x=DATA.holidays[d];
    const items=es.filter(e=>e.date===d).map(e=>({...e,_h:false})).concat(hs.filter(k=>k.date===d).map(k=>({...k,_h:true}))).sort((a,b)=>(a.allDay?-1:b.allDay?1:min(a.start)-min(b.start)));
    html+=`<div class="mday${d===t?' today':''}"><h3>${DAYS[i]} ${dparse(d).getDate()}${d===t?'<span class="tp">HOY</span>':''}</h3>${x?`<div class="holtag" style="display:inline-block">${h(x.name)}${holScope(x)}</div>`:''}`;
